## URL pública do app (configurada no Cloudflare Tunnel)
APP_URL=https://portaria.seu-dominio.com

## Timezone
TZ=America/Sao_Paulo

## PostgreSQL
POSTGRES_USER=condominio
POSTGRES_PASSWORD=mude_isso_aleatorio
POSTGRES_DB=condominio
DATABASE_URL=postgresql://condominio:mude_isso_aleatorio@postgres:5432/condominio?schema=public

## JWT
JWT_SECRET=mude_isso_aleatorio_64_chars
JWT_REFRESH_SECRET=mude_isso_aleatorio_64_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

## Síndico (Admin) - seed inicial
ADMIN_EMAIL=sindico@condominio.com
ADMIN_PASSWORD=mude_isso_no_primeiro_login

## Google Drive (Service Account)
GDRIVE_SA_FILE=/secrets/gdrive.json
GDRIVE_ROOT_FOLDER_ID=cole_id_da_pasta_raiz_aqui

## Portas internas
API_PORT=3001
WEB_PORT=3000

## Criptografia de credenciais sensíveis no DB (terminais Hikvision etc.)
## Gere com: openssl rand -hex 32  (resultado: 64 caracteres hex = 32 bytes)
APP_ENCRYPTION_KEY=mude_isso_64_chars_hex
